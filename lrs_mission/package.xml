<?xml version="1.0"?>
<package format="3">
  <name>lrs_mission</name>
  <version>0.1.0</version>
  <description>Assignment 1: 3D voxel map of the FEI hangar, obstacle inflation, path planning and mission execution</description>
  <maintainer email="simon.maco@mjolnirindustries.eu">SimonRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>libpcl-all-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
